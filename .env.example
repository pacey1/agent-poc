# =========================
# Server
# =========================
HOST=0.0.0.0
PORT=8000

# =========================
# Runtime mode
# - true  : no real external calls (safe local demo)
# - false : real MCP/LLM calls
# =========================
MOCK_MODE=true

# =========================
# LLM provider switch
# - grok | openai
# =========================
LLM_PROVIDER=grok

# Generic LLM fields (optional)
# If set, these take precedence over provider-specific keys below.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# =========================
# Grok (xAI)
# =========================
GROK_API_KEY=
GROK_MODEL=grok-3-mini
GROK_BASE_URL=https://api.x.ai/v1

# =========================
# OpenAI
# =========================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# =========================
# MCP endpoints (official/self-hosted gateway URLs)
# Set MOCK_MODE=false to use these.
# =========================
CONFLUENCE_MCP_SERVER_URL=
JIRA_MCP_SERVER_URL=
GITHUB_MCP_SERVER_URL=
MCP_AUTH_TOKEN=
